{
  "name": "microAgent",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "cd ../.. && nest build microAgent --config nest-cli.json",
    "start": "cd ../.. && nest start microAgent --config nest-cli.json",
    "start:dev": "cd ../.. && nest start microAgent --config nest-cli.json --watch",
    "start:debug": "cd ../.. && nest start microAgent --config nest-cli.json --debug --watch",
    "start:prod": "cd ../.. && node dist/apps/microAgent/main",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "29.2.4",
    "@types/node": "18.11.18",
    "@types/supertest": "^2.0.11",
    "jest": "29.3.1",
    "prettier": "^2.3.2",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "5.9.3"
  }
}

