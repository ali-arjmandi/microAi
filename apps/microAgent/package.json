{
  "name": "microAgent",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "cd ../.. && nest build microAgent --config nest-cli.json",
    "start": "cd ../.. && nest start microAgent --config nest-cli.json",
    "start:dev": "cd ../.. && nest start microAgent --config nest-cli.json --watch",
    "start:debug": "cd ../.. && nest start microAgent --config nest-cli.json --debug --watch",
    "start:prod": "cd ../.. && node dist/apps/microAgent/main",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {},
  "devDependencies": {}
}
