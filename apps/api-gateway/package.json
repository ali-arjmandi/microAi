{
  "name": "api-gateway",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "cd ../.. && nest build api-gateway --config nest-cli.json",
    "start": "cd ../.. && nest start api-gateway --config nest-cli.json",
    "start:dev": "cd ../.. && nest start api-gateway --config nest-cli.json --watch",
    "start:debug": "cd ../.. && nest start api-gateway --config nest-cli.json --debug --watch",
    "start:prod": "cd ../.. && node dist/apps/api-gateway/main",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {}
}
