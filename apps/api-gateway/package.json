{
  "name": "api-gateway",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "cd ../.. && nest build api-gateway --config nest-cli.json",
    "start": "cd ../.. && nest start api-gateway --config nest-cli.json",
    "start:dev": "cd ../.. && nest start api-gateway --config nest-cli.json --watch",
    "start:debug": "cd ../.. && nest start api-gateway --config nest-cli.json --debug --watch",
    "start:prod": "cd ../.. && node dist/apps/api-gateway/main",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "2",
    "@nestjs/core": "^9.0.0",
    "@nestjs/microservices": "9",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/swagger": "6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "joi": "^18.1.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "29.2.4",
    "@types/node": "18.11.18",
    "@types/supertest": "^2.0.11",
    "jest": "29.3.1",
    "prettier": "^2.3.2",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "5.9.3"
  }
}
