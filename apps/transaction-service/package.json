{
  "name": "transaction-service",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "cd ../.. && nest build transaction-service --config nest-cli.json",
    "start": "cd ../.. && nest start transaction-service --config nest-cli.json",
    "start:dev": "cd ../.. && nest start transaction-service --config nest-cli.json --watch",
    "start:debug": "cd ../.. && nest start transaction-service --config nest-cli.json --debug --watch",
    "start:prod": "cd ../.. && node dist/apps/transaction-service/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "amqplib": "^0.10.9",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8"
  }
}
