{
  "name": "transaction-service",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "cd ../.. && NODE_PATH=apps/transaction-service/node_modules nest build transaction-service --config nest-cli.json",
    "start": "cd ../.. && NODE_PATH=apps/transaction-service/node_modules nest start transaction-service --config nest-cli.json",
    "start:dev": "cd ../.. && NODE_PATH=apps/transaction-service/node_modules nest start transaction-service --config nest-cli.json --watch",
    "start:debug": "cd ../.. && NODE_PATH=apps/transaction-service/node_modules nest start transaction-service --config nest-cli.json --debug --watch",
    "start:prod": "cd ../.. && NODE_PATH=apps/transaction-service/node_modules node dist/apps/transaction-service/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/microservices": "9",
    "@nestjs/swagger": "6",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/jest": "29.2.4",
    "@types/node": "18.11.18",
    "jest": "29.3.1",
    "prettier": "^2.3.2",
    "prisma": "^7.5.0",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "5.9.3"
  }
}
