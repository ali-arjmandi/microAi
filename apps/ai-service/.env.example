PORT="3004"
RABBITMQ_URL="amqp://localhost:5672"
RABBITMQ_VERSION="v1"
RABBITMQ_PREFETCH="10"
# Create an account at https://openrouter.ai, add credits if needed, then create a key at https://openrouter.ai/keys and paste it here (never commit real keys).
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Real free-tier model on OpenRouter (not a placeholder); swap for another id from https://openrouter.ai/models if you prefer.
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
AI_TIMEOUT_MS="12000"
AI_MAX_RETRIES="2"
