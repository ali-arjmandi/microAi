{
  "name": "ai-service",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "cd ../.. && nest build ai-service --config nest-cli.json",
    "start": "cd ../.. && nest start ai-service --config nest-cli.json",
    "start:dev": "cd ../.. && nest start ai-service --config nest-cli.json --watch",
    "start:debug": "cd ../.. && nest start ai-service --config nest-cli.json --debug --watch",
    "start:prod": "cd ../.. && node dist/apps/ai-service/main",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {},
  "devDependencies": {}
}
