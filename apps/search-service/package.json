{
  "name": "search-service",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "cd ../.. && nest build search-service --config nest-cli.json",
    "start": "cd ../.. && nest start search-service --config nest-cli.json",
    "start:dev": "cd ../.. && nest start search-service --config nest-cli.json --watch",
    "start:debug": "cd ../.. && nest start search-service --config nest-cli.json --debug --watch",
    "start:prod": "cd ../.. && node dist/apps/search-service/main",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.3.4",
    "amqplib": "^0.10.9"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8"
  }
}
