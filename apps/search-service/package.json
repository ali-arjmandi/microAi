{
  "name": "search-service",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "cd ../.. && nest build search-service --config nest-cli.json",
    "start": "cd ../.. && nest start search-service --config nest-cli.json",
    "start:dev": "cd ../.. && nest start search-service --config nest-cli.json --watch",
    "start:debug": "cd ../.. && nest start search-service --config nest-cli.json --debug --watch",
    "start:prod": "cd ../.. && node dist/apps/search-service/main",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "2",
    "@nestjs/core": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "joi": "^18.1.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/jest": "29.2.4",
    "@types/node": "18.11.18",
    "jest": "29.3.1",
    "prettier": "^2.3.2",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "^4.7.4"
  }
}
