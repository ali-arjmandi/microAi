{
  "name": "microAgent",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:api-gateway": "nest build api-gateway",
    "build:transaction-service": "nest build transaction-service",
    "build:ai-service": "nest build ai-service",
    "build:microAgent": "nest build microAgent",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:api-gateway": "nest start api-gateway",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "start:debug:api-gateway": "nest start api-gateway --debug --watch",
    "start:prod:api-gateway": "node dist/apps/api-gateway/main",
    "start:transaction-service": "nest start transaction-service",
    "start:dev:transaction-service": "nest start transaction-service --watch",
    "start:debug:transaction-service": "nest start transaction-service --debug --watch",
    "start:prod:transaction-service": "node dist/apps/transaction-service/main",
    "start:ai-service": "nest start ai-service",
    "start:dev:ai-service": "nest start ai-service --watch",
    "start:debug:ai-service": "nest start ai-service --debug --watch",
    "start:prod:ai-service": "node dist/apps/ai-service/main",
    "start:microAgent": "nest start microAgent",
    "start:dev:microAgent": "nest start microAgent --watch",
    "start:debug:microAgent": "nest start microAgent --debug --watch",
    "start:prod:microAgent": "node dist/apps/microAgent/main",
    "lint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/microAgent/test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "29.2.4",
    "@types/node": "18.11.18",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "29.3.1",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "^4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  }
}
